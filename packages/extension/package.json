{
    "name": "duet",
    "displayName": "Duet",
    "description": "Life OS for VS Code",
    "version": "0.0.6",
    "publisher": "duet-org",
    "engines": {
        "vscode": "^1.108.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "mcpServerDefinitionProviders": [
            {
                "id": "duet-ai-kit",
                "label": "Duet AI Kit"
            }
        ],
        "commands": [
            {
                "command": "duet.selectDataFolder",
                "title": "Duet: Select Data Folder"
            },
            {
                "command": "duet.refresh",
                "title": "Duet: Refresh Index",
                "icon": "$(refresh)",
                "shortTitle": "Обновить"
            },
            {
                "command": "duet.dumpIndex",
                "title": "Duet: Dump Index (Debug)"
            },
            {
                "command": "duet.addBusiness",
                "title": "Добавить бизнес",
                "icon": "$(plus)",
                "shortTitle": "Добавить"
            },
            {
                "command": "duet.openInCurrentWindow",
                "title": "Открыть в текущем окне",
                "icon": "$(go-to-file)",
                "shortTitle": "Открыть"
            },
            {
                "command": "duet.openInNewWindow",
                "title": "Открыть в новом окне",
                "icon": "$(link-external)",
                "shortTitle": "В новом окне"
            },
            {
                "command": "duet.contextSettings",
                "title": "Настройки контекста",
                "icon": "$(gear)",
                "category": "Duet",
                "shortTitle": "Настройки"
            },
            {
                "command": "duet.openDataFolder",
                "title": "Открыть папку DuetData",
                "icon": "$(folder-opened)",
                "category": "Duet"
            },
            {
                "command": "duet.changeDataFolder",
                "title": "Изменить расположение DuetData",
                "icon": "$(folder)",
                "category": "Duet"
            },
            {
                "command": "duet.showContextHelp",
                "title": "Показать справку",
                "category": "Duet"
            },
            {
                "command": "duet.retryBackend",
                "title": "Повторить запуск backend",
                "category": "Duet"
            },
            {
                "command": "duet.showPythonHelp",
                "title": "Справка по установке Python",
                "category": "Duet"
            },
            {
                "command": "duet.showBackendLogs",
                "title": "Показать логи backend",
                "category": "Duet"
            },
            {
                "command": "duet.openBusinessWorkspace",
                "title": "Открыть бизнес",
                "icon": "$(go-to-file)"
            },
            {
                "command": "duet.openBusinessWorkspaceNewWindow",
                "title": "Открыть бизнес в новом окне",
                "icon": "$(link-external)"
            },
            {
                "command": "duet.toggleExpand",
                "title": "Развернуть/Свернуть всё",
                "icon": "$(fold)"
            }
        ],
        "submenus": [
            {
                "id": "duet.contextSettingsMenu",
                "label": "Настройки",
                "icon": "$(gear)"
            }
        ],
        "menus": {
            "duet.contextSettingsMenu": [
                {
                    "command": "duet.openDataFolder",
                    "group": "1_folder"
                },
                {
                    "command": "duet.changeDataFolder",
                    "group": "1_folder"
                }
            ],
            "view/title": [
                {
                    "command": "duet.refresh",
                    "when": "view == duet.context",
                    "group": "navigation@1"
                },
                {
                    "command": "duet.addBusiness",
                    "when": "view == duet.context",
                    "group": "navigation@2"
                },
                {
                    "submenu": "duet.contextSettingsMenu",
                    "when": "view == duet.context",
                    "group": "navigation@3"
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business0",
                    "group": "navigation@1",
                    "args": { "index": 0 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business0",
                    "group": "navigation@2",
                    "args": { "index": 0 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business0",
                    "group": "navigation@3",
                    "args": { "index": 0 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business1",
                    "group": "navigation@1",
                    "args": { "index": 1 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business1",
                    "group": "navigation@2",
                    "args": { "index": 1 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business1",
                    "group": "navigation@3",
                    "args": { "index": 1 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business2",
                    "group": "navigation@1",
                    "args": { "index": 2 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business2",
                    "group": "navigation@2",
                    "args": { "index": 2 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business2",
                    "group": "navigation@3",
                    "args": { "index": 2 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business3",
                    "group": "navigation@1",
                    "args": { "index": 3 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business3",
                    "group": "navigation@2",
                    "args": { "index": 3 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business3",
                    "group": "navigation@3",
                    "args": { "index": 3 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business4",
                    "group": "navigation@1",
                    "args": { "index": 4 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business4",
                    "group": "navigation@2",
                    "args": { "index": 4 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business4",
                    "group": "navigation@3",
                    "args": { "index": 4 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business5",
                    "group": "navigation@1",
                    "args": { "index": 5 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business5",
                    "group": "navigation@2",
                    "args": { "index": 5 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business5",
                    "group": "navigation@3",
                    "args": { "index": 5 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business6",
                    "group": "navigation@1",
                    "args": { "index": 6 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business6",
                    "group": "navigation@2",
                    "args": { "index": 6 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business6",
                    "group": "navigation@3",
                    "args": { "index": 6 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business7",
                    "group": "navigation@1",
                    "args": { "index": 7 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business7",
                    "group": "navigation@2",
                    "args": { "index": 7 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business7",
                    "group": "navigation@3",
                    "args": { "index": 7 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business8",
                    "group": "navigation@1",
                    "args": { "index": 8 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business8",
                    "group": "navigation@2",
                    "args": { "index": 8 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business8",
                    "group": "navigation@3",
                    "args": { "index": 8 }
                },
                {
                    "command": "duet.openBusinessWorkspace",
                    "when": "view == duet.business9",
                    "group": "navigation@1",
                    "args": { "index": 9 }
                },
                {
                    "command": "duet.openBusinessWorkspaceNewWindow",
                    "when": "view == duet.business9",
                    "group": "navigation@2",
                    "args": { "index": 9 }
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.business9",
                    "group": "navigation@3",
                    "args": { "index": 9 }
                }
            ],
            "view/item/context": [
                {
                    "command": "duet.openInCurrentWindow",
                    "when": "view =~ /^duet\\.business\\d$/ && viewItem != placeholder",
                    "group": "inline@1"
                },
                {
                    "command": "duet.openInNewWindow",
                    "when": "view =~ /^duet\\.business\\d$/ && viewItem != placeholder",
                    "group": "inline@2"
                }
            ]
        },
        "configuration": {
            "title": "Duet",
            "properties": {
                "duet.data_folder": {
                    "type": "string",
                    "description": "Path to DuetData folder (e.g. ~/DuetData)"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "duet-explorer",
                    "title": "Duet 0.0.6",
                    "icon": "resources/duet-icon.svg"
                }
            ]
        },
        "views": {
            "duet-explorer": [
                {
                    "id": "duet.onboarding",
                    "name": "DUET",
                    "when": "!config.duet.data_folder"
                },
                {
                    "id": "duet.context",
                    "name": "КОНТЕКСТ",
                    "when": "config.duet.data_folder"
                },
                {
                    "id": "duet.business0",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 0"
                },
                {
                    "id": "duet.business1",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 1"
                },
                {
                    "id": "duet.business2",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 2"
                },
                {
                    "id": "duet.business3",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 3"
                },
                {
                    "id": "duet.business4",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 4"
                },
                {
                    "id": "duet.business5",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 5"
                },
                {
                    "id": "duet.business6",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 6"
                },
                {
                    "id": "duet.business7",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 7"
                },
                {
                    "id": "duet.business8",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 8"
                },
                {
                    "id": "duet.business9",
                    "name": "Бизнес",
                    "when": "config.duet.data_folder && duet.businessCount > 9"
                },
                {
                    "id": "duet.projects",
                    "name": "ПРОЕКТЫ",
                    "when": "config.duet.data_folder"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "duet.context",
                "contents": "Нет открытой папки.\n[Открыть папку](command:vscode.openFolder)"
            },
            {
                "view": "duet.context",
                "contents": "$(sync~spin) Запуск backend...",
                "when": "duet.hasDataFolder && duet.initializing"
            },
            {
                "view": "duet.context",
                "contents": "$(error) Python 3.10+ не найден\n\nDuet требует Python 3.10 или новее.\n\n[Повторить](command:duet.retryBackend) · [Справка](command:duet.showPythonHelp)",
                "when": "duet.hasDataFolder && duet.initFailed.python"
            },
            {
                "view": "duet.context",
                "contents": "$(error) Ошибка запуска backend\n\n[Повторить](command:duet.retryBackend) · [Логи](command:duet.showBackendLogs)",
                "when": "duet.hasDataFolder && duet.initFailed && !duet.initFailed.python"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package && node bundle-backend.js",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "vsix": "node build-vsix.js",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src --ext ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "18.x",
        "@types/sql.js": "^1.4.9",
        "@types/vscode": "^1.108.1",
        "@types/write-file-atomic": "^4.0.3",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.19.8",
        "eslint": "^8.56.0",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.3.3",
        "vitest": "^1.0.4"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.0.0",
        "sql.js": "^1.13.0",
        "write-file-atomic": "^7.0.0",
        "zod": "^3.25.0"
    }
}
