{
    "name": "duet",
    "displayName": "Duet",
    "description": "Life OS for VS Code",
    "version": "0.0.1",
    "publisher": "duet-org",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "duet.selectDataFolder",
                "title": "Duet: Select Data Folder"
            },
            {
                "command": "duet.refresh",
                "title": "Duet: Refresh Index",
                "icon": "$(refresh)",
                "shortTitle": "Обновить"
            },
            {
                "command": "duet.dumpIndex",
                "title": "Duet: Dump Index (Debug)"
            },
            {
                "command": "duet.addBusiness",
                "title": "Добавить бизнес",
                "icon": "$(plus)",
                "shortTitle": "Добавить"
            },
            {
                "command": "duet.openInCurrentWindow",
                "title": "Открыть в текущем окне",
                "icon": "$(go-to-file)",
                "shortTitle": "Открыть"
            },
            {
                "command": "duet.openInNewWindow",
                "title": "Открыть в новом окне",
                "icon": "$(link-external)",
                "shortTitle": "В новом окне"
            },
            {
                "command": "duet.toggleExpand",
                "title": "Развернуть/Свернуть всё",
                "icon": "$(fold)",
                "category": "Duet",
                "shortTitle": "Развернуть/Свернуть"
            },
            {
                "command": "duet.contextSettings",
                "title": "Настройки контекста",
                "icon": "$(gear)",
                "category": "Duet",
                "shortTitle": "Настройки"
            },
            {
                "command": "duet.openDataFolder",
                "title": "Открыть папку DuetData",
                "icon": "$(folder-opened)",
                "category": "Duet"
            },
            {
                "command": "duet.changeDataFolder",
                "title": "Изменить расположение DuetData",
                "icon": "$(folder)",
                "category": "Duet"
            },
            {
                "command": "duet.showContextHelp",
                "title": "Показать справку",
                "category": "Duet"
            },
            {
                "command": "duet.openAllBusinesses",
                "title": "Открыть все дела",
                "icon": "$(link-external)",
                "category": "Duet",
                "shortTitle": "Все дела"
            }
        ],
        "submenus": [
            {
                "id": "duet.contextSettingsMenu",
                "label": "Настройки",
                "icon": "$(gear)"
            }
        ],
        "menus": {
            "duet.contextSettingsMenu": [
                {
                    "command": "duet.openDataFolder",
                    "group": "1_folder"
                },
                {
                    "command": "duet.changeDataFolder",
                    "group": "1_folder"
                }
            ],
            "view/title": [
                {
                    "submenu": "duet.contextSettingsMenu",
                    "when": "view == duet.context",
                    "group": "navigation"
                },
                {
                    "command": "duet.refresh",
                    "when": "view == duet.businesses",
                    "group": "navigation@1"
                },
                {
                    "command": "duet.addBusiness",
                    "when": "view == duet.businesses",
                    "group": "navigation@2"
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.businesses",
                    "group": "navigation@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "duet.openAllBusinesses",
                    "when": "view == duet.businesses && viewItem == header",
                    "group": "inline"
                },
                {
                    "command": "duet.openInCurrentWindow",
                    "when": "view == duet.businesses && viewItem != header && viewItem != placeholder",
                    "group": "inline@1"
                },
                {
                    "command": "duet.openInNewWindow",
                    "when": "view == duet.businesses && viewItem != header && viewItem != placeholder",
                    "group": "inline@2"
                }
            ]
        },
        "configuration": {
            "title": "Duet",
            "properties": {
                "duet.data_folder": {
                    "type": "string",
                    "description": "Path to DuetData folder (e.g. ~/DuetData)"
                }
            }
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "duet-explorer",
                    "title": "Duet",
                    "icon": "resources/duet-icon.svg"
                }
            ]
        },
        "views": {
            "duet-explorer": [
                {
                    "id": "duet.onboarding",
                    "name": "DUET",
                    "when": "!config.duet.data_folder"
                },
                {
                    "id": "duet.context",
                    "name": "КОНТЕКСТ",
                    "when": "config.duet.data_folder"
                },
                {
                    "id": "duet.businesses",
                    "name": "ДЕЛА",
                    "when": "config.duet.data_folder"
                },
                {
                    "id": "duet.projects",
                    "name": "ПРОЕКТЫ",
                    "when": "config.duet.data_folder"
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "duet.context",
                "contents": "Нет открытой папки.\n[Открыть папку](command:vscode.openFolder)"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src --ext ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "18.x",
        "@types/sql.js": "^1.4.9",
        "@types/vscode": "^1.85.0",
        "@types/write-file-atomic": "^4.0.3",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "esbuild": "^0.19.8",
        "eslint": "^8.56.0",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.3.3",
        "vitest": "^1.0.4"
    },
    "dependencies": {
        "sql.js": "^1.13.0",
        "write-file-atomic": "^7.0.0"
    }
}
