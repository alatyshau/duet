{
    "name": "duet",
    "displayName": "Duet",
    "description": "Life OS for VS Code",
    "version": "0.0.37",
    "publisher": "duet-org",
    "engines": {
        "vscode": "^1.104.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "duet.refresh",
                "title": "Duet: Refresh Index",
                "icon": "$(refresh)",
                "shortTitle": "Обновить"
            },
            {
                "command": "duet.dumpIndex",
                "title": "Duet: Dump Index (Debug)"
            },
            {
                "command": "duet.openInCurrentWindow",
                "title": "Открыть в текущем окне",
                "icon": "$(go-to-file)",
                "shortTitle": "Открыть"
            },
            {
                "command": "duet.openInNewWindow",
                "title": "Открыть в новом окне",
                "icon": "$(link-external)",
                "shortTitle": "В новом окне"
            },
            {
                "command": "duet.toggleExpand",
                "title": "Развернуть/Свернуть всё",
                "icon": "$(fold)",
                "category": "Duet",
                "shortTitle": "Развернуть/Свернуть"
            },
            {
                "command": "duet.contextSettings",
                "title": "Настройки контекста",
                "icon": "$(gear)",
                "category": "Duet",
                "shortTitle": "Настройки"
            },
            {
                "command": "duet.openDataFolder",
                "title": "Открыть папку DuetData",
                "icon": "$(folder-opened)",
                "category": "Duet"
            },
            {
                "command": "duet.openAllRootContexts",
                "title": "Открыть все дела в новом окне",
                "icon": "$(link-external)",
                "category": "Duet",
                "shortTitle": "В новом окне"
            },
            {
                "command": "duet.openAllRootContextsHere",
                "title": "Открыть все дела",
                "icon": "$(go-to-file)",
                "category": "Duet",
                "shortTitle": "Все дела"
            },
            {
                "command": "duet.copyAtPath",
                "title": "Копировать @-путь",
                "category": "Duet",
                "shortTitle": "@-путь"
            }
        ],
        "submenus": [
            {
                "id": "duet.contextSettingsMenu",
                "label": "Настройки",
                "icon": "$(gear)"
            }
        ],
        "menus": {
            "duet.contextSettingsMenu": [
                {
                    "command": "duet.openDataFolder",
                    "group": "1_folder"
                }
            ],
            "view/title": [
                {
                    "submenu": "duet.contextSettingsMenu",
                    "when": "view == duet.context",
                    "group": "navigation"
                },
                {
                    "command": "duet.refresh",
                    "when": "view == duet.contexts",
                    "group": "navigation@1"
                },
                {
                    "command": "duet.toggleExpand",
                    "when": "view == duet.contexts",
                    "group": "navigation@3"
                }
            ],
            "explorer/context": [
                {
                    "command": "duet.copyAtPath",
                    "when": "workspaceFolderCount > 0",
                    "group": "6_copypath@100"
                }
            ],
            "commandPalette": [
                {
                    "command": "duet.copyAtPath",
                    "when": "false"
                }
            ],
            "view/item/context": [
                {
                    "command": "duet.openAllRootContextsHere",
                    "when": "view == duet.contexts && viewItem == header",
                    "group": "inline@1"
                },
                {
                    "command": "duet.openAllRootContexts",
                    "when": "view == duet.contexts && viewItem == header",
                    "group": "inline@2"
                },
                {
                    "command": "duet.openInCurrentWindow",
                    "when": "view == duet.contexts && viewItem != header && viewItem != placeholder && viewItem != separator",
                    "group": "inline@1"
                },
                {
                    "command": "duet.openInNewWindow",
                    "when": "view == duet.contexts && viewItem != header && viewItem != placeholder && viewItem != separator",
                    "group": "inline@2"
                }
            ]
        },
        "keybindings": [
            {
                "command": "duet.copyAtPath",
                "key": "alt+shift+c",
                "mac": "cmd+shift+c",
                "when": "(filesExplorerFocus || editorTextFocus) && !inputFocus"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "duet-explorer",
                    "title": "Duet 0.0.37",
                    "icon": "resources/duet-icon.svg"
                }
            ]
        },
        "views": {
            "duet-explorer": [
                {
                    "id": "duet.status",
                    "name": "DUET",
                    "when": "!duet.ready"
                },
                {
                    "id": "duet.context",
                    "name": "КОНТЕКСТ",
                    "when": "duet.hasPointer && duet.ready",
                    "initialSize": 1
                },
                {
                    "id": "duet.contexts",
                    "name": "ДЕЛА",
                    "when": "duet.hasPointer && duet.ready",
                    "initialSize": 4
                }
            ]
        },
        "viewsWelcome": [
            {
                "view": "duet.status",
                "contents": "$(sync~spin) Подключение к backend...",
                "when": "duet.initializing"
            },
            {
                "view": "duet.status",
                "contents": "Установите и запустите Duet Host.\n\n[Перезагрузить окно](command:workbench.action.reloadWindow)"
            },
            {
                "view": "duet.context",
                "contents": "Нет открытой папки.\n[Открыть папку](command:vscode.openFolder)"
            }
        ],
        "mcpServerDefinitionProviders": [
            {
                "id": "duet",
                "label": "Duet"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "npm run check-types && npm run lint && node esbuild.js",
        "watch": "npm-run-all -p watch:*",
        "watch:esbuild": "node esbuild.js --watch",
        "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
        "package": "npm run check-types && npm run lint && node esbuild.js --production",
        "vsix": "node build-vsix.js",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "check-types": "tsc --noEmit",
        "lint": "eslint src --ext ts",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "18.x",
        "@types/vscode": "^1.104.0",
        "@typescript-eslint/eslint-plugin": "^8.52.0",
        "@typescript-eslint/parser": "^8.52.0",
        "@vscode/vsce": "^3.7.1",
        "esbuild": "^0.19.8",
        "eslint": "^8.56.0",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.3.3",
        "vitest": "^1.0.4"
    },
    "dependencies": {}
}
